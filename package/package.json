{
  "name": "@402signal/algorand-batch-buyer",
  "version": "0.2.0",
  "description": "Buyer-owned Algorand atomic group and aggregate invoice client",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
