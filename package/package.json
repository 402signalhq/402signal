    "manifest-profile.mjs",
    "examples/manifest.ts"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "10.0.0-alpha.46",
    "@x402/core": "2.25.0"
